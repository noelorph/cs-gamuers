@startuml
!pragma layout smetana
skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName SansSerif
skinparam defaultFontSize 14
skinparam ArrowColor #334155
skinparam BorderColor #334155
skinparam NoteBackgroundColor #FFF8DC
skinparam NoteBorderColor #B6A16C
skinparam roundcorner 8
skinparam sequenceMessageAlign center
skinparam maxMessageSize 300
title FC-08  Staff and account access safeguards
' Requirements: PERM-01 PERM-04 ACC-11 ACC-12 ACC-17 ACC-18 ACC-19 NOTICE-01 NOTICE-02 REPORT-03 P-08
start
:Administrator selects another account and permitted action;
if (Own role change or self-deactivation?) then (yes)
  :Refuse action;
  stop
else (no)
endif
if (Would remove last active Administrator?) then (yes)
  :Refuse action;
  stop
else (no)
endif
if (Removing Faculty access with content still owned?) then (yes)
  :Require Program Head to transfer all owned content first;
  :Keep account unchanged until transfer completes;
  stop
else (no)
endif
if (Reactivation requested?) then (yes)
  if (Student account?) then (yes)
    :Administrator performs fresh enrollment check;
  else (staff)
    :Administrator verifies current staff authorization;
  endif
  if (Verification passes?) then (yes)
    :Restore authorized access;
  else (no)
    :Keep account deactivated;
    stop
  endif
else (deactivation or staff role change)
  :Require and record reason;
  :Apply change and end existing sessions;
endif
:Record administrative action and email affected person;
:Preserve account history and learning records;
stop
footer CS-GAMUERS | FC-08 | Product behavior
@enduml
