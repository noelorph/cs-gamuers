# Server-only configuration. Fill in locally; never commit real values.
# APP_ORIGIN must be the approved LAN HTTPS origin, without a path.
APP_ORIGIN=
SUPABASE_URL=
SUPABASE_SECRET_KEY=
DEMO_PROJECT_REF=

# Operator attestation only: set to the exact project ref after hosted hook/TTL settings are verified.
# This does not configure Supabase; do not copy a TEST attestation to the demo project.
AUTH_MAIL_HOOK_VERIFIED_PROJECT_REF=

SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Separate free hosted test project; never point tests at demo.
TEST_SUPABASE_URL=
TEST_SUPABASE_SECRET_KEY=
TEST_SUPABASE_PROJECT_REF=

# Caddy overwrites both trusted headers. Use a random secret of at least 32 characters.
# Bind Next only to 127.0.0.1; do not expose its port to the LAN.
LOCAL_PROXY_SECRET=
# Set only after native-gate-probe, ordinary-user RLS and dashboard settings verification.
# This is an operator attestation, not proof by itself. Leave blank while verification is pending.
AUTH_PASSWORD_GATE_VERIFIED_PROJECT_REF=
# Optional already-running local HTTPS E2E rehearsal server, with trusted certificates.
PLAYWRIGHT_BASE_URL=
# Authenticated mutations additionally require the exact synthetic test target.
E2E_AUTH_PROJECT_REF=
# Keep retired values privately only for the negative native gate probe; never use as application credentials.
TEST_SUPABASE_PUBLISHABLE_KEY=
TEST_REVOKED_ANON_KEY=
TEST_REVOKED_SERVICE_ROLE_KEY=
# Explicit opt-in for tests/integration/native-gate.test.ts, exact isolated project ref only.
RUN_NATIVE_GATE_PROBE=
